* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #0d1117;
    color: #e6edf3;
    height: 100vh;
    overflow: hidden;
}


/* HEADER */

.topbar {
    height: 60px;
    border-bottom: 1px solid #30363d;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 20px;

    background: #161b22;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 18px;
    font-weight: 600;
}

.logo-icon {
    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 8px;

    background: #238636;
    color: white;

    font-weight: bold;
}

.top-actions {
    display: flex;
    gap: 8px;
}

button {
    border: 1px solid #30363d;

    background: #21262d;
    color: #e6edf3;

    padding: 8px 14px;

    border-radius: 6px;

    cursor: pointer;

    font-size: 14px;
}

button:hover {
    background: #30363d;
}

.run-btn {
    background: #238636;
    border-color: #2ea043;
    color: white;
}

.run-btn:hover {
    background: #2ea043;
}


/* APP */

.app {
    height: calc(100vh - 90px);

    display: flex;
}


/* SIDEBAR */

.sidebar {
    width: 230px;

    border-right: 1px solid #30363d;

    background: #161b22;

    padding: 20px 12px;
}

.sidebar-title {
    color: #8b949e;

    text-transform: uppercase;

    font-size: 12px;
    font-weight: 600;

    padding: 0 8px 15px;
}

.database-title {
    padding: 8px;

    font-weight: 600;

    cursor: pointer;
}

.table {
    padding: 8px 12px;

    color: #8b949e;

    cursor: pointer;

    border-radius: 6px;

    font-size: 14px;
}

.table:hover {
    background: #21262d;
    color: #e6edf3;
}

.table span {
    margin-right: 8px;
}


/* WORKSPACE */

.workspace {
    flex: 1;

    display: flex;
    flex-direction: column;

    min-width: 0;
}


/* EDITOR */

.editor-header {
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 15px;

    background: #161b22;

    border-bottom: 1px solid #30363d;

    font-size: 13px;
}

.status {
    color: #8b949e;
}

.editor-wrapper {
    height: 45%;

    background: #0d1117;
}

#sqlEditor {
    width: 100%;
    height: 100%;

    resize: none;

    border: none;
    outline: none;

    padding: 20px;

    background: #0d1117;
    color: #e6edf3;

    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;

    font-size: 15px;
    line-height: 1.6;
}


/* RESULTS */

.results {
    flex: 1;

    min-height: 0;

    border-top: 1px solid #30363d;
}

.results-header {
    height: 42px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0 15px;

    background: #161b22;

    border-bottom: 1px solid #30363d;

    font-size: 13px;
}

#resultInfo {
    color: #8b949e;
}

.result-container {
    height: calc(100% - 42px);

    overflow: auto;
}

.empty-result {
    height: 100%;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    color: #8b949e;

    text-align: center;
}

.empty-icon {
    font-size: 40px;
    margin-bottom: 10px;
}

.empty-result h3 {
    color: #e6edf3;
    margin-bottom: 5px;
}


/* TABLE */

.result-table {
    width: 100%;

    border-collapse: collapse;

    font-family: monospace;

    font-size: 14px;
}

.result-table th {
    position: sticky;
    top: 0;

    background: #161b22;

    color: #e6edf3;

    text-align: left;

    padding: 10px;

    border-bottom: 1px solid #30363d;
}

.result-table td {
    padding: 9px 10px;

    border-bottom: 1px solid #21262d;

    color: #c9d1d9;
}

.result-table tr:hover td {
    background: #161b22;
}


/* FOOTER */

footer {
    height: 30px;

    background: #161b22;

    border-top: 1px solid #30363d;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0 15px;

    color: #8b949e;

    font-size: 11px;
}


/* MOBILE */

@media (max-width: 700px) {

    .sidebar {
        display: none;
    }

    .topbar {
        padding: 0 10px;
    }

    .editor-wrapper {
        height: 40%;
    }

    #sqlEditor {
        font-size: 13px;
    }
}
