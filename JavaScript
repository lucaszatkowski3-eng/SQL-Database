/* SQL AUSFÜHREN */

function executeSQL() {

    const sql = editor.value.trim();

    if (!sql) {
        showError("Keine SQL-Abfrage eingegeben.");
        return;
    }

    status.textContent = "Wird ausgeführt...";


    try {

        const result = parseSQL(sql);

        displayResults(result);

        status.textContent = "Erfolgreich";

    } catch (error) {

        showError(error.message);

        status.textContent = "Fehler";

    }

}


/*
    Sehr einfacher SQL-Parser.

    Unterstützt momentan:

    SELECT *
    SELECT spalte
    FROM tabelle
    LIMIT
*/

function parseSQL(sql) {

    const normalized = sql
        .replace(/\s+/g, " ")
        .trim();

    const match = normalized.match(
        /^SELECT\s+(.+?)\s+FROM\s+([a-zA-Z0-9_]+)(?:\s+LIMIT\s+(\d+))?;?$/i
    );


    if (!match) {

        throw new Error(
            "Diese SQL-Abfrage wird momentan nicht unterstützt."
        );

    }


    const columns = match[1];

    const tableName = match[2];

    const limit = match[3]
        ? parseInt(match[3])
        : null;


    const table = database[tableName];


    if (!table) {

        throw new Error(
            `Tabelle "${tableName}" existiert nicht.`
        );

    }


    let rows = [...table];


    if (limit !== null) {

        rows = rows.slice(0, limit);

    }


    if (columns === "*") {

        return rows;

    }


    const selectedColumns = columns
        .split(",")
        .map(column => column.trim());


    return rows.map(row => {

        const newRow = {};

        selectedColumns.forEach(column => {

            if (!(column in row)) {

                throw new Error(
                    `Spalte "${column}" existiert nicht.`
                );

            }

            newRow[column] = row[column];

        });

        return newRow;

    });

}


/* ERGEBNIS ANZEIGEN */

function displayResults(rows) {

    if (!rows.length) {

        resultContainer.innerHTML = `
            <div class="empty-result">
                <div class="empty-icon">∅</div>
                <h3>Keine Ergebnisse</h3>
                <p>Die Abfrage hat keine Zeilen zurückgegeben.</p>
            </div>
        `;

        resultInfo.textContent = "0 Zeilen";

        return;

    }


    const columns = Object.keys(rows[0]);


    let html = `
        <table class="result-table">

            <thead>
                <tr>
    `;


    columns.forEach(column => {

        html += `<th>${column}</th>`;

    });


    html += `
                </tr>
            </thead>

            <tbody>
    `;


    rows.forEach(row => {

        html += "<tr>";

        columns.forEach(column => {

            html += `<td>${row[column]}</td>`;

        });

        html += "</tr>";

    });


    html += `
            </tbody>

        </table>
    `;


    resultContainer.innerHTML = html;


    resultInfo.textContent =
        `${rows.length} ${rows.length === 1 ? "Zeile" : "Zeilen"}`;

}


/* FEHLER */

function showError(message) {

    resultContainer.innerHTML = `
        <div class="empty-result">

            <div class="empty-icon">⚠</div>

            <h3>SQL-Fehler</h3>

            <p>${message}</p>

        </div>
    `;

    resultInfo.textContent = "Fehler";

}


/* LEEREN */

clearBtn.addEventListener("click", () => {

    editor.value = "";

    resultContainer.innerHTML = `
        <div class="empty-result">

            <div class="empty-icon">▤</div>

            <h3>Keine Ergebnisse</h3>

            <p>Führe eine SQL-Abfrage aus.</p>

        </div>
    `;

    resultInfo.textContent = "Noch keine Abfrage ausgeführt";

    status.textContent = "Bereit";

});


/* BUTTON */

runBtn.addEventListener("click", executeSQL);


/* STRG/CMD + ENTER */

editor.addEventListener("keydown", event => {

    if (
        (event.ctrlKey || event.metaKey) &&
        event.key === "Enter"
    ) {

        executeSQL();

    }

});
